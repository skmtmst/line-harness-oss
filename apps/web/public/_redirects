# V2で統合して消えた旧ルート。
#
# ブックマーク・社内Wiki・LINEのリッチメニューから旧URLを踏んでいる
# 可能性があるので、消さずに恒久リダイレクト（308）で新しい場所へ送る。
# リッチメニューは作り直さない限りURLが変わらないため、ここを消すと
# 友だちが踏んだときに404になる。
#
# next.config の redirects() は使えない。output: 'export' には
# リダイレクトを処理するサーバが無いので、Cloudflare Pages が読む
# このファイルに書く必要がある。
#
# /pools/new や /affiliates/new のような作成画面は残す。親のパスだけを
# 対象にしているので、下の階層は素通りする。
#
# /affiliates はここに書かない。_redirects はクエリを条件にできず、
# /affiliates?tab=offers へ来た人を tab=affiliates へ落としてしまうため。
# /affiliates の画面側（page.tsx）が ?tab= を保ったまま /conversions へ
# 送るので、ここに戻さないこと。

/duplicates      /friends?tab=duplicates     308
/users           /friends?tab=merged         308
/support         /chats?channel=email        308
/updates         /emergency?tab=history      308
/pools           /accounts?tab=pools         308
/booking/staff   /booking/menus?tab=staff    308

# Issue #638: サイトマップ/案内URLとして出回ったが実体の無い5本。
# いずれも正規ルートへ 308 で送る。/booking は親パスだけを対象にするので
# /booking/bookings など下の階層は素通りする。
/booking/menus/list  /booking/menus            308
/booking/schedule    /booking/staff/shifts     308
/booking/rules       /booking/menus?tab=rules  308
/booking             /booking/bookings         308
/dashboard/scenarios /scenarios                308
