# 名前だけの例。実値・秘密情報をコミットしない。
# 使う機能の行だけ残して設定する（空文字と未設定は同じとは限らない）。

# 旧自己更新画面の公開キー。未設定なら旧操作拒否、現行Workerの更新口は404。新しい秘密を入れない
NEXT_PUBLIC_ADMIN_API_KEY=

# 管理画面が通信するWorkerの公開URL。未設定なら通信層の初期化で例外
NEXT_PUBLIC_API_URL=

# 特商法リンク。未設定なら共通サイトの/legal/
NEXT_PUBLIC_COMMERCE_LAW_URL=

# 問い合わせリンク。未設定なら共通サイトの/contact/
NEXT_PUBLIC_CONTACT_URL=

# 会話AIの入口。未設定=false。trim/小文字化後trueのみ。今回オフの決定を保つ
NEXT_PUBLIC_CONVERSATION_AI_ENABLED=

# Googleビジネスの管理画面入口。未設定=false。trim/小文字化後trueのみ
NEXT_PUBLIC_GOOGLE_BUSINESS_ENABLED=

# 統括テンプレート配布の入口。未設定=false。文字列1のみ有効
NEXT_PUBLIC_HQ_TEMPLATE_DISTRIBUTION_ENABLED=

# プライバシーリンク。未設定なら共通サイトの/privacy/
NEXT_PUBLIC_PRIVACY_URL=

# 飲食店試験の管理画面入口。未設定=false。trim/小文字化後trueのみ
NEXT_PUBLIC_RESTAURANT_TEST_ENABLED=

# 規約リンク。未設定なら共通musuboサイトの/terms/
NEXT_PUBLIC_TERMS_URL=

# Turnstileの公開site key。未設定=null。秘密鍵とは別
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 更新のお知らせ。未設定=true。文字列falseでだけ無効
NEXT_PUBLIC_UPDATE_BANNER_ENABLED=
