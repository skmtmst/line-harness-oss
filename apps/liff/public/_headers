# Enforced on every static response. Web bootstrap scripts are externalized by postbuild.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.line-scdn.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; media-src 'self' https: blob:; connect-src 'self' https:; worker-src 'self' blob:; frame-src 'self' blob: https://access.line.me https://liff.line.me https://liff-subwindow.line.me https://access.line.me https://miniapp.line.me; object-src 'none'; base-uri 'self'; frame-ancestors 'self' https://liff.line.me https://liff-subwindow.line.me https://access.line.me https://miniapp.line.me; script-src-attr 'none'; form-action 'self' https://access.line.me
