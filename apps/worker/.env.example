# 名前だけの例。実値・秘密情報をコミットしない。
# 使う機能の行だけ残して設定する（空文字と未設定は同じとは限らない）。
# 公開VITE_*は.env.local、秘密値/実行時文字列は.gitignore対象の.dev.varsへ分ける。
# D1/R2等はwrangler設定のbinding。これをそのまま稼働環境へ投入しない。

# 別サイトの管理画面cookie。未設定=false。文字列trueだけSameSite=Noneを許可する。許可originは別検査
ADMIN_ALLOW_CROSS_SITE=

# 廃止済みのHTTP自己更新の旧認証鍵。現行の/admin/update/*は404。新規設定不要、互換宣言をS02で照合する
ADMIN_API_KEY=

# cookieのStrict/Lax/None上書き。未設定は同一site判定とcross-site設定から決定
ADMIN_COOKIE_SAMESITE=

# 管理画面専用LINE LoginチャネルID。未設定はLINE_LOGIN_CHANNEL_IDへ
ADMIN_LINE_LOGIN_CHANNEL_ID=

# 管理画面専用LINE Login秘密鍵。未設定はLINE_LOGIN_CHANNEL_SECRETへ
ADMIN_LINE_LOGIN_CHANNEL_SECRET=

# 資格情報つきCORSの管理画面origin一覧。未設定=空の許可一覧
ADMIN_ORIGIN=

# 自己更新対象の管理画面Pagesプロジェクト名
ADMIN_PAGES_PROJECT=

# 管理画面の公開URL
ADMIN_PUBLIC_URL=

# AI開発ループの一方向報告専用HMAC鍵。既存中継鍵とは別
AI_LOOP_SLACK_REPORT_SECRET=

# 従来APIの認証鍵。公開側に転記しない
API_KEY=

# 画像品質low/medium/high。未設定=medium
BANNER_IMAGE_QUALITY=

# 課金対象外の統括の月間画像数の上書き。既定150。有料プランの制限とは分ける
BANNER_MONTHLY_IMAGES=

# 予約Stripe Connectのcallback URL
BOOKING_STRIPE_CONNECT_REDIRECT_URI=

# 予約Stripe試験Connectの公開client ID
BOOKING_STRIPE_TEST_CLIENT_ID=

# 予約のStripe試験API鍵
BOOKING_STRIPE_TEST_SECRET_KEY=

# CloudflareアカウントID
CF_ACCOUNT_ID=

# Workerの旧自己更新用Cloudflare権限token。手元laneの環境へ不要
CF_API_TOKEN=

# Codex起動を受け付けるSlack channel ID一覧
CODEX_ALLOWED_CHANNEL_IDS=

# Codex起動を受け付けるchannel名の接頭辞
CODEX_ALLOWED_CHANNEL_NAME_PREFIXES=

# Codex起動を受け付けるSlack team ID一覧
CODEX_ALLOWED_TEAM_IDS=

# 監査後の専用本線マージ。未設定=false。文字列1または小文字化後trueのみ（trimなし）。承認・対象制約は別途保持
CODEX_AUTO_MERGE_ENABLED=

# 自動マージ用のGitHub token
CODEX_AUTO_MERGE_GITHUB_TOKEN=

# 自動マージ対象の専用リポジトリ
CODEX_AUTO_MERGE_REPOSITORY=

# 公式Codex受領を待つ秒数。未設定=30
CODEX_OFFICIAL_RECEIPT_GRACE_SECONDS=

# 中継Queueの最大試行。未設定/不正は5。既存の1〜100への丸めを保つ
CODEX_QUEUE_MAX_ATTEMPTS=

# SlackからCodexへの中継。未設定=false。文字列1または小文字化後trueのみ（trimなし）
CODEX_RELAY_ENABLED=

# 中継元の利用者ID一覧
CODEX_RELAY_SOURCE_USER_IDS=

# Slack mention受領の署名鍵
CODEX_SLACK_MONITOR_SIGNING_SECRET=

# Codex作業状況のSlack中継署名鍵
CODEX_SLACK_RELAY_SECRET=

# Kenta用の作業状況中継署名鍵
CODEX_SLACK_RELAY_SECRET_KENTA=

# Masato用の作業状況中継署名鍵
CODEX_SLACK_RELAY_SECRET_MASATO=

# Slack上のCodexユーザー識別子
CODEX_SLACK_USER_ID=

# 問い合わせの既定送信/通知先
CONTACT_EMAIL=

# 自己更新対象のD1 ID
D1_DATABASE_ID=

# 実行環境の識別。未設定/不明な環境では試験APIを閉じる。localとdevelopmentは同一判定ではない
DEPLOY_ENV=

# ECからのWebhook署名鍵
ECCUBE_WEBHOOK_SECRET=

# 外部ファイル検査のhostとsecret名の対応。未設定は内蔵検査のみ
FILE_SCAN_ALLOWED_PAIRS=

# 会話AIの外部接続。未設定=false。文字列trueかつlocal/test/development/stagingのみ。本番は拒否
G2_OPENAI_ENABLED=

# 口コミ返信案のWorkers AIモデル。未設定はOPS_SUPPORT_AI_MODEL→コードの定数
GOOGLE_BUSINESS_AI_MODEL=

# GoogleビジネスAPIの有効化。未設定=false。trim/小文字化後trueのみ
GOOGLE_BUSINESS_ENABLED=

# Google BUSINESS OAuth client 公開ID。環境ごとに分ける
GOOGLE_BUSINESS_OAUTH_CLIENT_ID=

# Google BUSINESS OAuth client 秘密鍵。環境ごとに分ける
GOOGLE_BUSINESS_OAUTH_CLIENT_SECRET=

# 口コミ返信案のOpenAIテキストモデル。未設定はコードの定数
GOOGLE_BUSINESS_TEXT_MODEL=

# Google口コミ返信の公開。未設定=false。文字列trueのみ
GOOGLE_BUSINESS_WRITE_ENABLED=

# Google Calendar認証情報の専用AES-GCM鍵（通常vars禁止）
GOOGLE_CALENDAR_CREDENTIAL_ENCRYPTION_KEY=

# Googleサービスアカウントの識別子
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Googleサービスアカウントの秘密鍵
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Google SHEETS OAuth client 公開ID。環境ごとに分ける
GOOGLE_SHEETS_OAUTH_CLIENT_ID=

# Google SHEETS OAuth client 秘密鍵。環境ごとに分ける
GOOGLE_SHEETS_OAUTH_CLIENT_SECRET=

# InstagramとLINEの接続通知の共有鍵
IG_HARNESS_LINK_SECRET=

# Instagram連携先のAPI URL
IG_HARNESS_URL=

# Instagram Login用の独立した公開ID
INSTAGRAM_APP_ID=

# Instagram Login用の独立した秘密鍵
INSTAGRAM_APP_SECRET=

# 従来API移行用の予備認証鍵
LEGACY_API_KEY=

# 自己更新対象のLIFF Pagesプロジェクト名
LIFF_PAGES_PROJECT=

# LIFFの公開URL
LIFF_PUBLIC_URL=

# 既定LIFF URL。アカウント固有設定のfallback
LIFF_URL=

# 既定LINEアカウントの送信認証token
LINE_CHANNEL_ACCESS_TOKEN=

# 既定LINE MessagingチャネルID
LINE_CHANNEL_ID=

# 既定LINEアカウントのWebhook署名検証鍵
LINE_CHANNEL_SECRET=

# DB内のLINE認証情報のAES-GCM鍵。未設定でも無関係なAPIは起動する
LINE_CREDENTIAL_ENCRYPTION_KEY=

# LINE認証情報の鍵ローテーション用の旧鍵一覧（秘密）。未設定は旧鍵なし
LINE_CREDENTIAL_PREVIOUS_KEYS=

# LIFF/従来LINE LoginチャネルID
LINE_LOGIN_CHANNEL_ID=

# LIFF/従来LINE Loginチャネル秘密鍵
LINE_LOGIN_CHANNEL_SECRET=

# 更新manifestの上流URL。ブラウザはWorkerの代理取得を使う
MANIFEST_URL=

# R2 S3互換APIのアクセス鍵ID（secret保存）
MEDIA_R2_ACCESS_KEY_ID=

# R2のS3互換API用バケット名
MEDIA_R2_BUCKET_NAME=

# R2 S3互換APIの秘密鍵
MEDIA_R2_SECRET_ACCESS_KEY=

# Meet相談callbackの署名検証鍵
MEET_CALLBACK_SECRET=

# Metaアプリ公開ID
META_APP_ID=

# Metaアプリ秘密鍵
META_APP_SECRET=

# Meta APIの版指定。実読取はSDKへの受渡しを含む
META_GRAPH_API_VERSION=

# Meta OAuth callback URL
META_REDIRECT_URI=

# Meta認証情報の暗号鍵
META_TOKEN_ENCRYPTION_KEY=

# Meta Webhook検証token
META_WEBHOOK_VERIFY_TOKEN=

# NEN EC連携の基底URL
NEN_EC_BASE_URL=

# ECへの会員ランク同期。未設定は送信停止。接続先側の契約も必要
NEN_EC_MEMBER_RANK_SYNC_ENABLED=

# NENリッチメニュー内のECリンク先
NEN_RICH_MENU_STORE_URL=

# バナー等のOpenAI認証鍵。未設定は該当生成を503で拒否。口コミ返信案はWorkers AIへfallback
OPENAI_API_KEY=

# 画像生成モデル名。未設定=gpt-image-1
OPENAI_IMAGE_MODEL=

# 署名済み配備イベントの検証鍵
OPERATIONS_DEPLOYMENT_SIGNING_SECRET=

# 運営通知のWeb Push秘密鍵
OPERATOR_PUSH_VAPID_PRIVATE_KEY=

# 運営通知のWeb Push公開鍵
OPERATOR_PUSH_VAPID_PUBLIC_KEY=

# 運営通知のWeb Push連絡先
OPERATOR_PUSH_VAPID_SUBJECT=

# 運営サポート下書きのWorkers AIモデル名。未設定はops-supportの定数
OPS_SUPPORT_AI_MODEL=

# 原文メール保存日数。未設定/不正は90。許容範囲の既存検査を維持
RAW_MAIL_RETENTION_DAYS=

# 飲食店メールを受け取るドメイン
RESTAURANT_INTAKE_DOMAIN=

# 確認待ち仮押さえの終了時刻（日本時間）。未設定/不正は23時。0〜23の整数のみ
RESTAURANT_REQUEST_HOLD_END_HOUR=

# 飲食店試験API。未設定=false。DEPLOY_ENVがstaging/development/testかつtrim/小文字化後trueのみ。本番・不明は常に拒否
RESTAURANT_TEST_ENABLED=

# DEMAECANの受注APIの基底URL
RT_DELIVERY_DEMAECAN_API_BASE_URL=

# DEMAECANの受注API認証token
RT_DELIVERY_DEMAECAN_API_TOKEN=

# 受信Webhookの許可IP一覧。媒体ごと指定が優先、共通一覧へfallback。空なら既存の拒否条件を適用。許可IPを増やさない
RT_DELIVERY_DEMAECAN_WEBHOOK_IP_ALLOWLIST=

# DEMAECANの受信Webhook署名鍵（32文字以上）
RT_DELIVERY_DEMAECAN_WEBHOOK_SECRET=

# ROCKETNOWの受注APIの基底URL
RT_DELIVERY_ROCKETNOW_API_BASE_URL=

# ROCKETNOWの受注API認証token
RT_DELIVERY_ROCKETNOW_API_TOKEN=

# 受信Webhookの許可IP一覧。媒体ごと指定が優先、共通一覧へfallback。空なら既存の拒否条件を適用。許可IPを増やさない
RT_DELIVERY_ROCKETNOW_WEBHOOK_IP_ALLOWLIST=

# ROCKETNOWの受信Webhook署名鍵（32文字以上）
RT_DELIVERY_ROCKETNOW_WEBHOOK_SECRET=

# デリバリー連携の実送信。未設定=false。trim/小文字化後trueのみ。オフは台帳だけ
RT_DELIVERY_SEND_ENABLED=

# UBEREATSの受注APIの基底URL
RT_DELIVERY_UBEREATS_API_BASE_URL=

# UBEREATSの受注API認証token
RT_DELIVERY_UBEREATS_API_TOKEN=

# UBEREATSのOAuth client ID
RT_DELIVERY_UBEREATS_CLIENT_ID=

# UBEREATSのOAuth client秘密鍵
RT_DELIVERY_UBEREATS_CLIENT_SECRET=

# Uber接続先の組。未設定/productionは本番ホスト、sandboxは試験ホスト、不明な値は接続を拒否。送信スイッチとは別
RT_DELIVERY_UBEREATS_ENVIRONMENT=

# Uber token疎通検査専用の署名鍵。32文字以上。未設定/短い鍵は検査拒否
RT_DELIVERY_UBEREATS_PROBE_SECRET=

# UBEREATSのOAuth callback上書き
RT_DELIVERY_UBEREATS_REDIRECT_URI=

# 受信Webhookの許可IP一覧。媒体ごと指定が優先、共通一覧へfallback。空なら既存の拒否条件を適用。許可IPを増やさない
RT_DELIVERY_UBEREATS_WEBHOOK_IP_ALLOWLIST=

# UBEREATSの受信Webhook署名鍵（32文字以上）
RT_DELIVERY_UBEREATS_WEBHOOK_SECRET=

# 受信Webhookの許可IP一覧。媒体ごと指定が優先、共通一覧へfallback。空なら既存の拒否条件を適用。許可IPを増やさない
RT_DELIVERY_WEBHOOK_IP_ALLOWLIST=

# 読取専用Search Console対象サイト
SEARCH_CONSOLE_SITE_URL=

# 既存の安全監視ルールごとの正整数JSON。無効値はルール固有の安全な既定。上限変更をこの文書は許可しない
SECURITY_MONITOR_THRESHOLDS=

# AI開発ループの一方向報告channel ID
SLACK_AI_LOOP_CHANNEL_ID=

# Slack botの認証token
SLACK_BOT_TOKEN=

# 司令塔報告のchannel ID
SLACK_COMMAND_CHANNEL_ID=

# PR報告の既定channel ID
SLACK_DEFAULT_PR_CHANNEL_ID=

# エラー報告のchannel ID
SLACK_ERROR_CHANNEL_ID=

# アイデアのchannel ID
SLACK_IDEA_CHANNEL_ID=

# KentaのSlack ID
SLACK_KENTA_USER_ID=

# MasatoのSlack ID
SLACK_MASATO_USER_ID=

# PRとSlack channelの対応JSON
SLACK_PR_CHANNELS_JSON=

# Slackイベントの署名検証鍵
SLACK_SIGNING_SECRET=

# 未完了タスクのchannel ID
SLACK_TASK_CHANNEL_ID=

# Slackの利用者認証token
SLACK_USER_TOKEN=

# 統括課金Stripe通知の署名鍵
STRIPE_BILLING_WEBHOOK_SECRET=

# 統括課金のLIGHT月額Price ID
STRIPE_PRICE_LIGHT=

# 統括課金のLIGHT年額Price ID
STRIPE_PRICE_LIGHT_YEAR=

# 統括課金のPRO月額Price ID
STRIPE_PRICE_PRO=

# 統括課金のPRO年額Price ID
STRIPE_PRICE_PRO_YEAR=

# 統括課金のSTANDARD月額Price ID
STRIPE_PRICE_STANDARD=

# 統括課金のSTANDARD年額Price ID
STRIPE_PRICE_STANDARD_YEAR=

# 統括課金Stripeの認証鍵
STRIPE_SECRET_KEY=

# 予約Stripeテスト通知の署名鍵
STRIPE_TEST_WEBHOOK_SECRET=

# Stripe通知の署名鍵。未設定は対象受信を503で拒否
STRIPE_WEBHOOK_SECRET=

# サポートの受信メール識別子
SUPPORT_INBOUND_EMAIL=

# 統括からの問い合わせ通知先。未設定はCONTACT_EMAIL
SUPPORT_NOTIFY_EMAIL=

# 二段階認証の保存情報の暗号鍵
TOTP_ENCRYPTION_KEY=

# Turnstile検証の秘密鍵。未設定なら会員登録を拒否
TURNSTILE_SECRET_KEY=

# Worker同梱予約画面の接続ID。未設定=空文字
VITE_CALENDAR_CONNECTION_ID=

# Worker同梱LIFFの公開ID。URL指定等で解決できなければ未設定時に例外
VITE_LIFF_ID=

# 同じWorkerへ届く追加origin。LINE Webhookの同一環境判定用
WORKER_ALIAS_URLS=

# 自己更新対象のWorker名
WORKER_NAME=

# 外部に渡すWorkerの公開URL
WORKER_PUBLIC_URL=

# 認証cookie等の判定にも使うWorker URL
WORKER_URL=

# メール中継のホスト
XSERVER_MAIL_HOST=

# メール中継のパスワード
XSERVER_MAIL_PASSWORD=

# メール中継のユーザー名
XSERVER_MAIL_USER=

# メール中継の署名鍵
XSERVER_RELAY_SECRET=

# メール送信中継URL
XSERVER_RELAY_URL=

# X連携先のAPI URL
X_HARNESS_URL=
