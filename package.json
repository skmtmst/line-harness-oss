{
  "name": "line-oss-crm",
  "version": "0.24.0",
  "private": true,
  "description": "Open-source LINE Official Account CRM/marketing automation",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "deploy:worker": "pnpm --filter worker deploy",
    "deploy:web": "pnpm --filter web build",
    "db:migrate-line-credentials": "tsx scripts/db/migrate-line-account-credentials.ts",
    "db:dry-run-v6-automations": "tsx scripts/db/dry-run-automations.ts",
    "db:dry-run-v6-analytics": "tsx scripts/db/dry-run-analytics.ts",
    "db:dry-run-v6-funnels": "tsx scripts/db/dry-run-funnels.ts",
    "db:dry-run-scenario-delivery-timestamps": "tsx scripts/db/dry-run-scenario-delivery-timestamps.ts",
    "db:dry-run-affiliate-account-scope": "tsx scripts/db/dry-run-affiliate-account-scope.ts",
    "deploy:setup": "node packages/create-line-harness/dist/index.js",
    "deploy:update": "node packages/create-line-harness/dist/index.js update",
    "sandbox:create-line-harness": "bash scripts/deploy/run-create-line-harness-sandbox.sh",
    "test:scripts": "vitest run --config vitest.config.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "deploy:lock": "tsx scripts/deploy/deploy-lock.ts",
    "deploy:preflight": "tsx scripts/deploy/preflight.ts",
    "deploy:staging": "bash scripts/deploy/staging-deploy.sh",
    "build:bundle": "tsx scripts/release/build-bundle.ts",
    "qa:mock": "node scripts/visual-qa/mock-api.mjs",
    "qa:speed": "node apps/web/scripts/v8-guard/speed-check.mjs",
    "qa:web": "NEXT_PUBLIC_API_URL=http://127.0.0.1:8788 pnpm --filter web exec next dev --port 3101",
    "qa:shot": "playwright test scripts/visual-qa/capture.spec.mjs",
    "db:dry-run-automations": "tsx scripts/db/dry-run-automations.ts",
    "db:dry-run-analytics": "tsx scripts/db/dry-run-analytics.ts",
    "db:dry-run-funnels": "tsx scripts/db/dry-run-funnels.ts",
    "quality:check": "tsx scripts/structure/quality-check.mjs",
    "quality:update": "tsx scripts/structure/quality-check.mjs --update",
    "quality:test": "tsx --test scripts/structure/quality.test.mjs",
    "new:screen": "tsx scripts/scaffold/new.ts screen",
    "new:route": "tsx scripts/scaffold/new.ts route",
    "quality:typecheck": "tsc --noEmit --allowJs --checkJs --skipLibCheck --module nodenext --target es2022 --allowImportingTsExtensions scripts/structure/quality-inventory.mjs scripts/structure/repository-files.mjs scripts/structure/quality-check.mjs"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "pnpm": {
    "overrides": {
      "@line/liff": "2.31.1",
      "axios": "1.20.0",
      "browserslist": "4.28.9",
      "defu": "6.1.7",
      "fast-uri": "3.1.8",
      "follow-redirects": "1.16.1",
      "esbuild@>=0.27.3 <0.28.1": "0.28.1",
      "vite": "6.4.4",
      "form-data": "4.0.6",
      "hono": "4.13.12",
      "ip-address": "10.7.1",
      "nanoid": "3.3.18",
      "picomatch": "4.0.7",
      "postcss": "8.5.28",
      "react-router": "7.18.3",
      "sharp": "0.35.5",
      "undici": "7.29.1",
      "ws": "8.21.3",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "@hono/node-server": "1.19.17",
      "qs": "6.16.1",
      "body-parser": "2.3.0",
      "@babel/core": "7.29.7"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "22.19.15",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.27",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.77.0"
  }
}
