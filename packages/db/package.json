{
  "name": "@line-crm/db",
  "version": "0.4.0",
  "description": "D1 database query helpers for LINE CRM",
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "schema.sql",
    "migrations",
    "bootstrap-meta.json",
    "bootstrap.sql"
  ],
  "scripts": {
    "build": "pnpm run generate:bootstrap",
    "pretest": "pnpm --filter @line-crm/shared build && pnpm run generate:bootstrap",
    "test": "vitest run",
    "pretypecheck": "pnpm --filter @line-crm/shared build && pnpm run generate:bootstrap",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run generate:bootstrap",
    "generate:bootstrap": "node ./scripts/generate-bootstrap.mjs",
    "check:bootstrap": "node ./scripts/generate-bootstrap.mjs --check"
  },
  "dependencies": {
    "@line-crm/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0"
  },
  "keywords": [
    "line",
    "crm",
    "d1",
    "cloudflare"
  ]
}
