{
  "name": "@line-harness/plugin-myservice",
  "version": "0.1.0",
  "private": true,
  "description": "LINE Harness plugin template — copy this directory to start a new integration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "build:mcp": "tsup mcp-server/index.ts --format esm --out-dir dist-mcp",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "pretypecheck": "pnpm --filter @line-harness/sdk build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@line-harness/sdk": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260317.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@types/node": "22.19.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "wrangler": "4.77.0",
    "zod": "^3.24.4"
  }
}
