{
  "name": "@line-harness/mcp-server",
  "version": "0.24.0",
  "description": "MCP server for LINE Harness — operate a LINE official account from AI agents over MCP",
  "type": "module",
  "bin": {
    "line-harness-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "pretypecheck": "pnpm --filter @line-harness/sdk build",
    "pretest": "pnpm --filter @line-harness/sdk build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "line",
    "crm",
    "mcp",
    "model-context-protocol",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Shudesu/line-harness-oss.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/Shudesu/line-harness-oss#readme",
  "bugs": {
    "url": "https://github.com/Shudesu/line-harness-oss/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "dependencies": {
    "@line-harness/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
